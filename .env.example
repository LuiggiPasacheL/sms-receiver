# Copy to .env and replace all three secrets before starting.
# Use URL-safe letters and numbers for POSTGRES_PASSWORD (it is part of a URL).
POSTGRES_PASSWORD=replaceWithALongRandomDatabasePassword
VIEWER_PASSWORD=replaceWithYourPrivateInboxPassword
FORWARDER_TOKEN=replaceWithALongRandomForwardingToken
APP_PORT=8080
POSTGRES_PORT=5432
# For Kubernetes, uncomment and configure your existing PostgreSQL connection.
# DATABASE_URL=postgres://sms_receiver:APP_PASSWORD@postgres.databases.svc:5432/sms_receiver?sslmode=disable
# Set true when the browser accesses the app through HTTPS.
COOKIE_SECURE=false
# Set both values to enable Cloudflare Access authentication for the inbox.
# CLOUDFLARE_ACCESS_TEAM_URL=https://YOUR_TEAM.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD
